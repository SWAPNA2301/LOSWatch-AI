# Copy this file to .env locally and fill in values on your own machine.
# Never commit .env or paste credentials into chat or source files.
# Snowflake org-account identifier, for example myorg-myaccount or an account locator.
LOSWATCH_SNOWFLAKE_ACCOUNT=your-org-account-identifier
# The explicit alias below is also accepted when LOSWATCH_SNOWFLAKE_ACCOUNT is absent.
# LOSWATCH_SNOWFLAKE_ORG_ACCOUNT=your-org-account-identifier
LOSWATCH_SNOWFLAKE_USER=your-login-name
# Recommended local development auth: built-in Snowflake local-application OAuth.
# The connector opens the authorization-code browser flow and supplies the
# built-in LOCAL_APPLICATION client defaults; no client secret is required.
LOSWATCH_SNOWFLAKE_AUTHENTICATOR=OAUTH_AUTHORIZATION_CODE
# Legacy SAML browser auth remains supported with externalbrowser if required.
# LOSWATCH_SNOWFLAKE_AUTHENTICATOR=externalbrowser
# For password auth instead, set authenticator=snowflake and provide this locally:
# LOSWATCH_SNOWFLAKE_PASSWORD=replace-locally
LOSWATCH_SNOWFLAKE_WAREHOUSE=LOS_WH
LOSWATCH_SNOWFLAKE_DATABASE=LOSWATCH_AI
LOSWATCH_SNOWFLAKE_SCHEMA=MONITORING
# Application role expected after manual setup:
LOSWATCH_SNOWFLAKE_ROLE=LOSWATCH_APP
